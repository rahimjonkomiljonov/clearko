# LLM provider: ollama (local, default, nothing leaves your machine) | gemini (cloud, free tier)
LLM_PROVIDER=ollama
# ollama: a model you pulled, e.g. qwen2.5:7b or gemma3:4b.  gemini: e.g. gemini-2.5-flash
LLM_MODEL=qwen2.5:7b
# ollama: leave empty for http://localhost:11434
LLM_BASE_URL=
# chat model for the Russian translation step (gemma3:4b is good for Russian, useless for Uzbek)
LLM_TRANSLATE_MODEL=gemma3:4b
# Uzbek: nllb (Meta NLLB-200, needs the 'uz' extra, NON-COMMERCIAL licence) | llm (poor quality)
UZ_TRANSLATOR=nllb
NLLB_MODEL=facebook/nllb-200-distilled-1.3B
# auto = GPU if more than 3.5 GB of video memory is free, else CPU | cpu | cuda
NLLB_DEVICE=auto
# gemini only: a key from https://aistudio.google.com (put it in .env, never in git).
# For gemini set LLM_PROVIDER=gemini and LLM_MODEL=gemini-3.5-flash-lite (tested; model names change often:
# run eval/tools/check_gemini.py to see what your key can use).
# Free tier = sample documents only: Google may use the content. The web app shows a consent box.
# With a cloud provider LLM_TRANSLATE_MODEL / UZ_TRANSLATOR are ignored (the model translates itself).
LLM_API_KEY=

# OCR engine: paddle | easyocr
OCR_ENGINE=paddle
# auto | cpu | gpu:0
OCR_DEVICE=auto

# Preprocessing
BLUR_THRESHOLD=60.0
MAX_IMAGE_SIDE=2400

# ---- API ----
# comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
# true only behind exactly ONE trusted proxy: the rate limit then uses the last X-Forwarded-For entry
TRUST_PROXY=false
MAX_FILES=10
MAX_FILE_MB=12
MAX_TOTAL_MB=40
MAX_PAGES=12
# analyses per client; GLOBAL_PER_DAY caps everybody together (protects LLM cost)
RATE_PER_HOUR=10
RATE_PER_DAY=30
GLOBAL_PER_DAY=500
# finished results are kept in memory this long (seconds), then deleted
JOB_TTL_S=900
MAX_QUEUE=4
