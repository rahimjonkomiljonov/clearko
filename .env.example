# LLM provider: ollama (local, default, nothing leaves your machine) | gemini (cloud, free tier)
LLM_PROVIDER=ollama
# ollama: a model you pulled, e.g. qwen2.5:7b or gemma3:4b.  gemini: e.g. gemini-2.5-flash
LLM_MODEL=qwen2.5:7b
# ollama: leave empty for http://localhost:11434
LLM_BASE_URL=
# gemini only
LLM_API_KEY=

# OCR engine: paddle | easyocr
OCR_ENGINE=paddle
# auto | cpu | gpu:0
OCR_DEVICE=auto

# Preprocessing
BLUR_THRESHOLD=60.0
MAX_IMAGE_SIDE=2400
