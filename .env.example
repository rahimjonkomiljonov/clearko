# LLM provider: gemini | openai_compat
LLM_PROVIDER=gemini
LLM_API_KEY=
# Gemini free tier: pick a current Flash model id from https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-2.5-flash
# Only for openai_compat (Groq, OpenRouter, ...)
LLM_BASE_URL=

# OCR engine: paddle | easyocr
OCR_ENGINE=paddle
# auto | cpu | gpu:0
OCR_DEVICE=auto

# Preprocessing
BLUR_THRESHOLD=60.0
MAX_IMAGE_SIDE=2400
