# LLM provider: ollama (local, default, nothing leaves your machine) | gemini (cloud, free tier)
LLM_PROVIDER=ollama
# ollama: a model you pulled, e.g. qwen2.5:7b or gemma3:4b.  gemini: e.g. gemini-2.5-flash
LLM_MODEL=qwen2.5:7b
# ollama: leave empty for http://localhost:11434
LLM_BASE_URL=
# chat model for the Russian translation step (gemma3:4b is good for Russian, useless for Uzbek)
LLM_TRANSLATE_MODEL=gemma3:4b
# Uzbek: nllb (Meta NLLB-200, needs the 'uz' extra, NON-COMMERCIAL licence) | llm (poor quality)
UZ_TRANSLATOR=nllb
NLLB_MODEL=facebook/nllb-200-distilled-1.3B
# auto = GPU if more than 3.5 GB of video memory is free, else CPU | cpu | cuda
NLLB_DEVICE=auto
# gemini only
LLM_API_KEY=

# OCR engine: paddle | easyocr
OCR_ENGINE=paddle
# auto | cpu | gpu:0
OCR_DEVICE=auto

# Preprocessing
BLUR_THRESHOLD=60.0
MAX_IMAGE_SIDE=2400
